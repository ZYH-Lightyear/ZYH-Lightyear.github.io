{
  "name": "yehang-research-neighborhood",
  "private": true,
  "version": "0.8.1.1",
  "description": "Yehang Zhang's academic homepage and interactive Three.js research neighborhood, adapted from WowPage.",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZYH-Lightyear/ZYH-Lightyear.github.io"
  },
  "keywords": [
    "jekyll",
    "theme",
    "minimal"
  ],
  "contributors": [
    "Michael Rose",
    "Robert Zupko"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ZYH-Lightyear/ZYH-Lightyear.github.io/issues"
  },
  "homepage": "https://zyh-lightyear.github.io",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "three": "0.186.1",
    "fitvids": "^2.1.1",
    "jquery": "^3.7.1",
    "jquery-smooth-scroll": "^2.2.0",
    "magnific-popup": "^1.2.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "js-yaml": "4.3.2",
    "liquidjs": "10.29.0",
    "markdown-it": "14.3.2",
    "playwright": "1.63.0",
    "onchange": "^7.1.0",
    "uglify-js": "^3.17.4"
  },
  "scripts": {
    "dev": "node scripts/preview.mjs",
    "build": "node scripts/build.mjs",
    "test": "node scripts/check.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "uglify": "uglifyjs node_modules/jquery/dist/jquery.min.js node_modules/fitvids/dist/fitvids.min.js node_modules/magnific-popup/dist/jquery.magnific-popup.min.js node_modules/jquery-smooth-scroll/jquery.smooth-scroll.min.js assets/js/plugins/jquery.greedy-navigation.js assets/js/_main.js -c -m -o assets/js/main.min.js",
    "watch:js": "onchange \"src/**/*.js\" -- npm run build:js",
    "build:js": "node scripts/build.mjs --assets"
  }
}
